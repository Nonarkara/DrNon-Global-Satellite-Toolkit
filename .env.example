# ─────────────────────────────────────────────────────────────────────────────
# DrNon Global Satellite Toolkit — environment
#
# EVERY VARIABLE HERE IS OPTIONAL.
# `npm run dev` works from a cold clone with this file absent: STAC imagery
# search, NASA GIBS tiles, air quality, flights, satellite orbits and trends
# all run with no credentials. Run `npm run probe` to confirm.
#
# Add keys below only for the modules you actually want live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Tier 1: free key, issued instantly, highest value ───────────────────────

# NASA FIRMS — near-real-time fire/thermal hotspots (375 m VIIRS).
# Free, arrives by email in minutes: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_KEY=

# AQICN / WAQI — Thai PM2.5 station network.
# Free, instant: https://aqicn.org/data-platform/token/
# NOTE: the public "demo" token is accepted but returns zero stations.
AQICN_TOKEN=

# OpenAQ v3 — measured ground-station air quality.
# Free, instant: https://explore.openaq.org/
# NOTE: v2 is retired; v3 requires this key on every request.
OPENAQ_KEY=

# ── Tier 2: free account, lifts a rate limit or unlocks downloads ───────────

# OpenSky — live ADS-B aircraft. Works anonymously at ~400 credits/day;
# these credentials raise that substantially. https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA Earthdata Login — required to DOWNLOAD from ASF (SAR) and most DAACs.
# Search works without it. https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=
EARTHDATA_TOKEN=

# Copernicus Data Space — required to download full Sentinel SAFE products.
# STAC search works without it. https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Space-Track — full NORAD catalog. CelesTrak (no key) covers most needs.
# Manual approval, 1–2 days. https://www.space-track.org/
# GISTDA Disaster Platform Open API — Thai flood / fire / drought features
# and tiles. Free key at: https://api-gateway.gistda.or.th/v2
# Manual: https://disaster.gistda.or.th/services/open-api
GISTDA_API_KEY=

# Space-Track — full NORAD catalog. CelesTrak (no key) covers most needs.
# Manual approval, 1–2 days. https://www.space-track.org/
SPACE_TRACK_USER=
SPACE_TRACK_PASS=

# ACLED — armed conflict and protest events. https://acleddata.com/register/
ACLED_KEY=
ACLED_EMAIL=

# ── Tier 3: commercial or approval-gated ────────────────────────────────────

# Sentinel Hub — processed Sentinel imagery. Paid beyond a small trial.
SENTINEL_HUB_KEY=

# ReliefWeb — UN OCHA humanitarian reports.
# v1 is decommissioned; v2 rejects any appname OCHA has not approved.
# Request one (human review): https://reliefweb.int/help/api
RELIEFWEB_APPNAME=

FLIGHTLABS_KEY=
METEOBLUE_KEY=
METEOSOURCE_KEY=
PREDICTHQ_KEY=
NEWS_API_KEY=

# ── Infrastructure ──────────────────────────────────────────────────────────

# Dynamic COG tiler. Defaults to the public https://titiler.xyz demo, which
# has no SLA. Self-host before production:
#   docker run -p 8000:8000 ghcr.io/developmentseed/titiler:latest
NEXT_PUBLIC_TITILER_URL=

# Mapbox basemap (optional — MapLibre/GIBS/ESRI keyless fallbacks are used
# when this is unset).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# PostgreSQL + PostGIS, for ingestion/firms_ingest.py only.
DATABASE_URL=
