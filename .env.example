# App URL (used by modules that wrap internal API routes)
INTERNAL_API_URL=http://localhost:3000

# NASA FIRMS — thermal hotspot detection (MAP_KEY)
# Sign up: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# The old /api/config/realtime/ URL returns "Invalid API call" (checked 2026-09-27).
# This template's nasa-firms module wraps /api/fires, which is not shipped, so the
# panel stays on mock data until you add that route. ingestion/firms_ingest.py reads FIRMS_KEY.
FIRMS_KEY=your_firms_key_here

# PostgreSQL with PostGIS (optional — mock data used when absent)
DATABASE_URL=postgresql://user:pass@localhost:5432/satellite_db

# Supabase (optional — storage resolver in src/storage/database-architecture.ts)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mapbox (optional — map works without it via GIBS/ESRI/OSM fallbacks)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# LongDo Map (optional — Thai street basemap; tokenEnvVar in basemap-catalog.ts)
LONGDO_MAP_KEY=

# Stadia Maps (optional — terrain/toner basemaps)
STADIA_API_KEY=

# ── Module System API Keys (all optional — modules show mock data without keys) ──

# ACLED — Armed Conflict Location & Event Data
ACLED_KEY=
ACLED_EMAIL=

# Sentinel Hub — ESA processed satellite imagery (classic Sentinel Hub, not CDSE STAC)
SENTINEL_HUB_KEY=

# GISTDA Disaster Platform Open API — flood / fire / drought features and tiles
# Register a free key at: https://api-gateway.gistda.or.th/v2
# Manual: https://disaster.gistda.or.th/services/open-api
GISTDA_API_KEY=

# Space-Track — NORAD orbital catalog (register at space-track.org)
SPACE_TRACK_USER=
SPACE_TRACK_PASS=

# FlightLabs / AirLabs — aviation data for BKK/DMK
FLIGHTLABS_KEY=

# Meteoblue — high-resolution weather (100+ variables)
METEOBLUE_KEY=

# Meteosource — hyperlocal weather for Thai cities
METEOSOURCE_KEY=

# PredictHQ — real-world event intelligence
PREDICTHQ_KEY=

# NewsAPI — global news aggregation
NEWS_API_KEY=
