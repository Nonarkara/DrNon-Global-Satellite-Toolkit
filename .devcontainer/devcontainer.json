{
  "name": "DrNon Satellite Toolkit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "postCreateCommand": "npm install && pip install -r ingestion/requirements.txt",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Dashboard" },
    "8000": { "label": "TiTiler" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ]
    }
  }
}
