{
  "name": "drnon-global-satellite-toolkit",
  "version": "2.1.0",
  "description": "Runnable dashboard template for satellite and global-awareness data \u2014 STAC imagery search, dynamic COG tiling, and 31 pluggable data modules on Deck.gl + Next.js",
  "author": "Dr Non Arkaraprasertkul <https://github.com/Nonarkara>",
  "license": "MIT",
  "homepage": "https://github.com/Nonarkara/DrNon-Global-Satellite-Toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nonarkara/DrNon-Global-Satellite-Toolkit.git"
  },
  "keywords": [
    "satellite",
    "nasa-gibs",
    "sentinel-2",
    "modis",
    "viirs",
    "deck.gl",
    "wmts",
    "geospatial",
    "remote-sensing",
    "earth-observation",
    "dashboard-template",
    "next.js",
    "stac",
    "cloud-optimized-geotiff",
    "cog",
    "titiler",
    "copernicus",
    "landsat",
    "planetary-computer",
    "open-data"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe-sources.mjs",
    "probe:all": "node scripts/probe-sources.mjs --all",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "docs:sources": "node scripts/generate-source-docs.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/geo-layers": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "@tailwindcss/postcss": "^4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.3.1",
    "postcss": "^8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
